# WordPress GraphQL endpoint (server-side only)
WORDPRESS_GRAPHQL_ENDPOINT=http://localhost:8080/graphql

# WordPress public base URL (media, canonical helpers)
WORDPRESS_BASE_URL=http://localhost:8080

# Public frontend URL (canonical / Open Graph / sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Protects POST /api/revalidate — must match Docker ARIA_REVALIDATE_SECRET
REVALIDATION_SECRET=local-dev-revalidate-secret

# Contact form delivery (optional; contact page is methods-only for now)
# EMAIL_API_KEY=
# CONTACT_EMAIL=
